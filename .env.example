VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

VITE_ONESIGNAL_APP_ID=your_onesignal_app_id_here
VITE_ONESIGNAL_SAFARI_WEB_ID=your_safari_web_id_here

# Required in production: the app is served from Firebase Hosting, but the
# notify/calendar server functions live on Netlify — a different origin, so
# the relative "/.netlify/functions/..." path won't resolve. Point these at
# your actual Netlify site. Safe to leave unset for local `netlify dev`.
VITE_NOTIFY_FUNCTION_URL=https://your-site.netlify.app/.netlify/functions/notify
VITE_CALENDAR_FUNCTION_URL=https://your-site.netlify.app/.netlify/functions/calendar

# ── Server-side only — set these in Netlify's environment, NEVER with a
#    VITE_ prefix, and never commit real values for them ──
# FIREBASE_SERVICE_ACCOUNT_JSON=
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=
# SITE_URL=https://your-site.netlify.app
