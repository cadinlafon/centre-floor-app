VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

VITE_ONESIGNAL_APP_ID=your_onesignal_app_id_here
VITE_ONESIGNAL_SAFARI_WEB_ID=your_safari_web_id_here

# Optional override for the notification function URL (defaults to the
# Netlify function at /.netlify/functions/notify)
# VITE_NOTIFY_FUNCTION_URL=https://your-site.netlify.app/.netlify/functions/notify

# ── Server-side only — set these in Netlify's environment, NEVER with a
#    VITE_ prefix, and never commit real values for them ──
# FIREBASE_SERVICE_ACCOUNT_JSON=
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=
# SITE_URL=https://your-site.netlify.app
